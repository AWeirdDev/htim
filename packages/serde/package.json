{
  "name": "@htim/serde",
  "version": "0.0.1",
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "build": "tsdown src/index.ts src/client.ts src/server.ts --dts --out-dir dist"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "node": "./dist/index.mjs"
    },
    "./server": {
      "types": "./dist/server.d.mts",
      "node": "./dist/server.mjs"
    },
    "./client": {
      "types": "./dist/client.d.mts",
      "node": "./dist/client.mjs"
    }
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "dependencies": {
    "@htim/core": "workspace:*"
  },
  "files": [
    "./src/*",
    "./dist/*"
  ]
}
